@startuml
'https://plantuml.com/class-diagram

title Domain Model

skinparam classAttributeIconSize 0
hide circle
hide methods

class "DGS Administrator" {
}

class "SNS User" {
  - sns_number
  - name
  - birth_date
  - sex
  - postal_address
  - phone_number
  - email
  - citizen_card_number
}

class Employee {
  - name
  - postal_address
  - phone_number
  - email
}

class Nurse {
}

class Receptionist {
}

class "Vaccination Center" {
  - name
  - postal_address
  - phone_number
  - email
  - website_address
  - opening_hours
  - closing_hours
  - capacity_per_hour
}

class "Healthcare Center" {
  - ars
  - ages
}

class "Community Mass Vaccination Center" {
}

class "Waiting Room" {
}

class "Recovery Room" {
}

class Vaccine {
  - commercial_name
  - brand
}

class "Vaccine Type" {
  - code
  - disease
  - short_description
}

class "Vaccine Technology" {
  - name
}

class Appointment {
  - date
  - time
}


class "Vaccine Administration" {
  - lot_number
}

class "Adverse Reaction" {
  - description
}

class "Vaccination Certificate" {
  - issue_date
}

' --- Heranças ---

Nurse --|> Employee
Receptionist --|> Employee
"Healthcare Center" --|> "Vaccination Center"
"Community Mass Vaccination Center" --|> "Vaccination Center"


' --- Gestão de Entidades (Admin) ---

"DGS Administrator" "1" -right-- "0..*" Employee:  manages >
"DGS Administrator" "1" -right-- "0..*" "Vaccination Center": manages >
"DGS Administrator" "1" -right-- "0..*" Vaccine: manages >
"DGS Administrator" "1" -right-- "1..*" "Vaccine Type": manages >
"DGS Administrator" "1" -right-- "0..*" "Vaccine Technology": manages >


' --- Estrutura do Centro ---

"Vaccination Center" "1" *-- "1" "Waiting Room": has >
"Vaccination Center" "1" *-- "1" "Recovery Room": has >


' --- Relações do Processo ---

' Agendamento
"SNS User" "1..*" -right-- "0..*" Appointment: schedules >
Receptionist "0..*" -right-- "0..*" Appointment: assists >
Appointment "0..*" -down-- "1" "Vaccination Center": occurs at >
Appointment "1" -down-- "1" "Vaccine Type": for >

' Fluxo no Centro
Receptionist "1..*" -left-- "1..*" "SNS User": registers arrival >
Nurse "1..*" -right-- "1..*" "Vaccine Administration": performs >
Nurse "1..*" -right-- "0..*" "Adverse Reaction": records >
Nurse "1..*" -right-- "0..*" "Vaccination Certificate": issues on-site >

' Relações de Eventos
"Vaccine Administration" "1" -left-- "1" Appointment: fulfills >
"Vaccine Administration" "1" -right-- "1" Vaccine: uses >
"Vaccine Administration" "1" -down-- "0..1" "Adverse Reaction": results in >
"Vaccine Administration" "1" -down-- "0..1" "Vaccination Certificate": generates >

"SNS User" "1..*" -up-- "0..*" "Vaccination Certificate": obtains >

' Definição de Vacinas
Vaccine "1..*" -right-- "1" "Vaccine Type": has >
Vaccine "1..*" -right-- "1" "Vaccine Technology": uses >

@enduml