@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class RecordAdministrationUI {
  }
}

package "Core" {

  package "Controller" {
    class VaccineAdministrationController {
      + createVaccineAdministration(dto: VaccineAdministrationDTO): boolean
      + getAppointment(snsUserNumber: String): AppointmentDTO
    }
  }

  package "Service" {
    class VaccineAdministrationService {
      + createVaccineAdministration(dto: VaccineAdministrationDTO): boolean
      + getAppointment(snsUserNumber: String): AppointmentDTO
    }
  }

  package "Domain" {
    package "Model" {
      class VaccineAdministration {
        - administeredDate: DateTime
        - leaveDate: DateTime
        - lotNumber: String
        + create(user, vaccine, appointment, lot)
      }
      class SNSUser {}
      class Vaccine {}
      class Appointment {}
    }

    package "Repository" {
      class VaccineAdministrationRepository {
        + save(admin: VaccineAdministration): boolean
      }
      class SNSUserRepository {
        + findByNumber(number: String): SNSUser
      }
      class VaccineRepository {
        + findByLot(lot: String): Vaccine
      }
      class AppointmentRepository {
        + findById(id: String): Appointment
      }
    }
  }

  package "DTO" {
    class VaccineAdministrationDTO {
      - snsUserNumber: String
      - lotNumber: String
      - appointmentId: String
    }
    class AppointmentDTO {}
  }

  package "Mapper" {
    class VaccineAdministrationMapper {
      + toDTO(admin: VaccineAdministration): VaccineAdministrationDTO
      + toModel(dto: VaccineAdministrationDTO): VaccineAdministration
    }
  }
}

RecordAdministrationUI ..> VaccineAdministrationController
RecordAdministrationUI ..> VaccineAdministrationDTO

VaccineAdministrationController ..> VaccineAdministrationService
VaccineAdministrationController ..> VaccineAdministrationDTO

VaccineAdministrationService ..> VaccineAdministrationRepository
VaccineAdministrationService ..> SNSUserRepository
VaccineAdministrationService ..> VaccineRepository
VaccineAdministrationService ..> AppointmentRepository
VaccineAdministrationService ..> VaccineAdministration
VaccineAdministrationService ..> VaccineAdministrationMapper

VaccineAdministrationMapper ..> VaccineAdministrationDTO
VaccineAdministrationMapper ..> VaccineAdministration

VaccineAdministrationRepository "1" --> "*" VaccineAdministration : saves

@enduml