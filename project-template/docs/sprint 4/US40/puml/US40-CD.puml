@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class ConsultWaitingRoomUI {
  }
}

package "Core" {

  package "Controller" {
    class ConsultWaitingRoomController {
      + getWaitingList(): List<AppointmentDTO>
    }
  }

  package "Service" {
    class WaitingRoomService {
      + getWaitingList(): List<AppointmentDTO>
    }
  }

  package "Domain" {
    package "Model" {
      class VaccinationCenter {
        + getWaitingRoom(): WaitingRoom
      }
      class WaitingRoom {
        + getAppointments(): List<Appointment>
      }
      class Appointment {
        - arrivalTime: DateTime
        - state: AppointmentState
      }
      class SNSUser {}
    }

    package "Repository" {
      class VaccinationCenterRepository {
        + getCurrentCenter(): VaccinationCenter
      }
    }
  }

  package "DTO" {
    class AppointmentDTO {
      - snsUserNumber
      - snsUserName
      - arrivalTime
    }
  }

  package "Mapper" {
    class AppointmentMapper {
      + toDTOList(list: List<Appointment>): List<AppointmentDTO>
      + toDTO(app: Appointment): AppointmentDTO
    }
  }
}

ConsultWaitingRoomUI ..> ConsultWaitingRoomController
ConsultWaitingRoomUI ..> AppointmentDTO

ConsultWaitingRoomController ..> WaitingRoomService
ConsultWaitingRoomController ..> AppointmentDTO

WaitingRoomService ..> VaccinationCenterRepository
WaitingRoomService ..> VaccinationCenter
WaitingRoomService ..> WaitingRoom
WaitingRoomService ..> AppointmentMapper

AppointmentMapper ..> Appointment
AppointmentMapper ..> AppointmentDTO

VaccinationCenter "1" --> "1" WaitingRoom : has
WaitingRoom "1" --> "*" Appointment : holds

@enduml