@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class ScheduleAppointmentUI {
  }
}

package "Core" {

  package "Controller" {
    class ScheduleAppointmentController {
      + getVaccinationCenters(): List<VaccinationCenterDTO>
      + getVaccineTypes(): List<VaccineTypeDTO>
      + createAppointment(dto: AppointmentDTO): boolean
    }
  }

  package "Service" {
    class ScheduleAppointmentService {
      + getVaccinationCenters(): List<VaccinationCenterDTO>
      + getVaccineTypes(): List<VaccineTypeDTO>
      + createAppointment(dto: AppointmentDTO): boolean
    }
  }

  package "Domain" {
    package "Model" {
      class Appointment {
        - date: Date
        - time: Time
        + create(user, center, type, date, time)
      }
      class SNSUser {}
      class VaccinationCenter {}
      class VaccineType {}
    }

    package "Repository" {
      class AppointmentRepository {
        + save(app: Appointment): boolean
      }
      class VaccinationCenterRepository {
        + findAll(): List<VaccinationCenter>
        + findById(id: String): VaccinationCenter
      }
      class VaccineTypeRepository {
        + findAll(): List<VaccineType>
        + findByCode(code: String): VaccineType
      }
      class SNSUserRepository {
        + findByNumber(num: String): SNSUser
      }
    }
  }

  package "DTO" {
    class AppointmentDTO {
      - snsUserNumber
      - centerId
      - vaccineTypeCode
      - date
      - time
    }
    class VaccinationCenterDTO {}
    class VaccineTypeDTO {}
  }

  package "Mapper" {
    class AppointmentMapper {
      + toModel(dto: AppointmentDTO): Appointment
    }
    class VaccinationCenterMapper {
      + toDTOList(list: List<VaccinationCenter>): List<VaccinationCenterDTO>
    }
    class VaccineTypeMapper {
      + toDTOList(list: List<VaccineType>): List<VaccineTypeDTO>
    }
  }
}

ScheduleAppointmentUI ..> ScheduleAppointmentController
ScheduleAppointmentUI ..> AppointmentDTO

ScheduleAppointmentController ..> ScheduleAppointmentService
ScheduleAppointmentController ..> AppointmentDTO

ScheduleAppointmentService ..> AppointmentRepository
ScheduleAppointmentService ..> VaccinationCenterRepository
ScheduleAppointmentService ..> VaccineTypeRepository
ScheduleAppointmentService ..> SNSUserRepository
ScheduleAppointmentService ..> Appointment
ScheduleAppointmentService ..> AppointmentMapper
ScheduleAppointmentService ..> VaccinationCenterMapper
ScheduleAppointmentService ..> VaccineTypeMapper

AppointmentRepository "1" --> "*" Appointment : saves

@enduml