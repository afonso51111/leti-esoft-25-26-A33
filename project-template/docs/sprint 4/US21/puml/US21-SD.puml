@startuml
autonumber

actor "SNS User" as User
participant ":ScheduleAppointmentUI" as UI
participant ":ScheduleAppointmentController" as CTRL
participant ":ScheduleAppointmentService" as SVC
participant ":VaccinationCenterRepository" as VCRepo
participant ":VaccineTypeRepository" as VTRepo
participant ":AppointmentRepository" as AppRepo
participant ":SNSUserRepository" as UserRepo
participant ":AppointmentMapper" as MAPPER
participant "dto: AppointmentDTO" as DTO
participant "app: Appointment" as APP

activate User
User -> UI : asks to schedule vaccine
activate UI

' 1. Obter Lista de Centros
UI -> CTRL : getVaccinationCenters()
activate CTRL
CTRL -> SVC : getVaccinationCenters()
activate SVC
SVC -> VCRepo : findAll()
activate VCRepo
VCRepo --> SVC : listCenters
deactivate VCRepo
SVC --> CTRL : listCenterDTOs
deactivate SVC
CTRL --> UI : listCenterDTOs
deactivate CTRL

UI --> User : shows centers and asks to select
deactivate UI

User -> UI : selects a center (centerId)
activate UI

' 2. Obter Lista de Tipos de Vacina
UI -> CTRL : getVaccineTypes()
activate CTRL
CTRL -> SVC : getVaccineTypes()
activate SVC
SVC -> VTRepo : findAll()
activate VTRepo
VTRepo --> SVC : listTypes
deactivate VTRepo
SVC --> CTRL : listTypeDTOs
deactivate SVC
CTRL --> UI : listTypeDTOs
deactivate CTRL

UI --> User : shows types and asks to select
deactivate UI

User -> UI : selects a type (typeCode)
activate UI

UI --> User : asks for date and time
deactivate UI

User -> UI : enters date and time
activate UI

' 3. Criar o Agendamento
' Assumindo que o UI já sabe o SNS Number do utilizador logado
UI -> DTO** : create(snsNumber, centerId, typeCode, date, time)

UI -> CTRL : createAppointment(dto)
activate CTRL

CTRL -> SVC : createAppointment(dto)
activate SVC

' Validar disponibilidade (simplificado)
SVC -> VCRepo : findById(dto.centerId)
activate VCRepo
VCRepo --> SVC : center
deactivate VCRepo

' Obter entidades necessárias
SVC -> UserRepo : findByNumber(dto.snsNumber)
activate UserRepo
UserRepo --> SVC : user
deactivate UserRepo

SVC -> VTRepo : findByCode(dto.typeCode)
activate VTRepo
VTRepo --> SVC : vType
deactivate VTRepo

' Criar objeto de domínio
SVC -> APP** : create(user, center, vType, date, time)

' Guardar
SVC -> AppRepo : save(app)
activate AppRepo
AppRepo --> SVC : success
deactivate AppRepo

SVC --> CTRL : success
deactivate SVC

CTRL --> UI : success
deactivate CTRL

UI --> User : displays success message
deactivate UI

deactivate User
@enduml