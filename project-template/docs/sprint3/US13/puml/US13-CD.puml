@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class SpecifyVaccineUI {
  }
}

package "Core" {

  package "Controller" {
    class SpecifyVaccineController {
      + getVaccineTypes(): List<VaccineTypeDTO>
      + createVaccine(dto: VaccineDTO): boolean
    }
  }

  package "Service" {
    class VaccineService {
      + getVaccineTypes(): List<VaccineTypeDTO>
      + createVaccine(dto: VaccineDTO): boolean
    }
  }

  package "Domain" {
    package "Model" {
      class Vaccine {
        - name: String
        - brand: String
        + create(name, brand, type, process)
      }
      class VaccineType {}
      class AdministrationProcess {}
    }

    package "Repository" {
      class VaccineRepository {
        + save(vaccine: Vaccine): boolean
      }
      class VaccineTypeRepository {
        + findAll(): List<VaccineType>
        + findByCode(code: String): VaccineType
      }
    }
  }

  package "DTO" {
    class VaccineDTO {
      - name
      - brand
      - typeCode
      - ageGroupsList
      - dosesList
    }
    class VaccineTypeDTO {}
  }

  package "Mapper" {
    class VaccineMapper {
      + toModel(dto: VaccineDTO, type: VaccineType): Vaccine
    }
    class VaccineTypeMapper {
      + toDTOList(list: List<VaccineType>): List<VaccineTypeDTO>
    }
  }
}

SpecifyVaccineUI ..> SpecifyVaccineController
SpecifyVaccineUI ..> VaccineDTO

SpecifyVaccineController ..> VaccineService
SpecifyVaccineController ..> VaccineDTO

VaccineService ..> VaccineRepository
VaccineService ..> VaccineTypeRepository
VaccineService ..> VaccineMapper
VaccineService ..> VaccineTypeMapper
VaccineService ..> Vaccine
VaccineService ..> VaccineType

VaccineMapper ..> VaccineDTO
VaccineMapper ..> Vaccine

VaccineRepository "1" --> "*" Vaccine : stores
Vaccine "1" --> "1" VaccineType : has
Vaccine "1" --> "*" AdministrationProcess : defines

@enduml