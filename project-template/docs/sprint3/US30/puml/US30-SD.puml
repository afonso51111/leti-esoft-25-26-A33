@startuml
autonumber

actor "Administrator" as Admin
participant ":LoadUsersUI" as UI
participant ":LoadUsersController" as CTRL
participant ":LoadUsersService" as SVC
participant ":CSVReader" as READER
participant "dto: SNSUserDTO" as DTO
participant ":SNSUserMapper" as MAPPER
participant ":SNSUserRepository" as REPO
participant "user: SNSUser" as USER

activate Admin
Admin -> UI : asks to load CSV file
activate UI

UI --> Admin : asks for file path
deactivate UI

Admin -> UI : provides file path
activate UI

UI -> CTRL : loadUsers(filePath)
activate CTRL

CTRL -> SVC : loadUsers(filePath)
activate SVC

' Serviço usa um leitor de CSV (Utilitário)
SVC -> READER : read(filePath)
activate READER
READER --> SVC : rawDataList
deactivate READER

' Loop para processar cada linha
loop for each line in rawDataList

    ' Criar DTO com dados crus
    SVC -> DTO** : create(name, snsNum, email, ...)

    ' Validar e Converter para Modelo
    SVC -> MAPPER : toModel(dto)
    activate MAPPER
    MAPPER -> USER** : create(name, snsNum, email, ...)
    MAPPER --> SVC : user
    deactivate MAPPER

    ' Persistir no Repositório
    SVC -> REPO : save(user)
    activate REPO
    REPO --> SVC : boolean (success)
    deactivate REPO

end loop

SVC --> CTRL : summary (count)
deactivate SVC

CTRL --> UI : summary
deactivate CTRL

UI --> Admin : displays success and number of users loaded
deactivate UI

deactivate Admin
@enduml