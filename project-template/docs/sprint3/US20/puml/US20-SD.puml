@startuml
autonumber

actor "Administrator" as Admin
participant ":RegisterReceptionistUI" as UI
participant ":RegisterReceptionistController" as CTRL
participant ":ReceptionistService" as SVC
participant "dto: ReceptionistDTO" as DTO
participant ":ReceptionistMapper" as MAPPER
participant ":ReceptionistRepository" as REPO
participant "receptionist: Receptionist" as MODEL
participant ":AuthFacade" as AUTH

activate Admin
Admin -> UI : asks to register a new receptionist
activate UI

UI --> Admin : asks for data (Name, Address, Phone, Email, CC)
deactivate UI

Admin -> UI : types data
activate UI

' UI cria o DTO com os dados inseridos
UI -> DTO** : create(name, address, phone, email, cc)

UI -> CTRL : registerReceptionist(dto)
activate CTRL

CTRL -> SVC : registerReceptionist(dto)
activate SVC

' 1. O Serviço usa o Mapper para converter DTO em Domínio
SVC -> MAPPER : toModel(dto)
activate MAPPER
MAPPER -> MODEL** : create(name, address, phone, email, cc)
MAPPER --> SVC : receptionist
deactivate MAPPER

' 2. O Serviço guarda o Rececionista no Repositório
SVC -> REPO : save(receptionist)
activate REPO
REPO --> SVC : boolean (success)
deactivate REPO

' 3. O Serviço regista o utilizador no sistema de autenticação (opcional mas comum)
SVC -> AUTH : addUserWithRole(name, email, "RECEPTIONIST")
activate AUTH
AUTH --> SVC : success
deactivate AUTH

SVC --> CTRL : success
deactivate SVC

CTRL --> UI : success
deactivate CTRL

UI --> Admin : displays success message and credentials
deactivate UI

deactivate Admin
@enduml