@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class RegisterReceptionistUI {
  }
}

package "Core" {

  package "Controller" {
    class RegisterReceptionistController {
      + registerReceptionist(dto: ReceptionistDTO): boolean
    }
  }

  package "Service" {
    class ReceptionistService {
      + registerReceptionist(dto: ReceptionistDTO): boolean
    }
  }

  package "Domain" {
    package "Model" {
      class Employee {
        - name: String
        - email: String
      }
      class Receptionist {
        + create(name, address, phone, email, cc)
      }
    }

    package "Repository" {
      class ReceptionistRepository {
        + save(receptionist: Receptionist): boolean
      }
    }
  }

  package "DTO" {
    class ReceptionistDTO {
      - name
      - address
      - phoneNumber
      - email
      - citizenCardNumber
    }
  }

  package "Mapper" {
    class ReceptionistMapper {
      + toModel(dto: ReceptionistDTO): Receptionist
      + toDTO(model: Receptionist): ReceptionistDTO
    }
  }
}

Receptionist --|> Employee

RegisterReceptionistUI ..> RegisterReceptionistController
RegisterReceptionistUI ..> ReceptionistDTO

RegisterReceptionistController ..> ReceptionistService
RegisterReceptionistController ..> ReceptionistDTO

ReceptionistService ..> ReceptionistRepository
ReceptionistService ..> ReceptionistMapper
ReceptionistService ..> Receptionist
ReceptionistService ..> ReceptionistDTO

ReceptionistMapper ..> ReceptionistDTO
ReceptionistMapper ..> Receptionist

ReceptionistRepository "1" --> "*" Receptionist : stores

@enduml