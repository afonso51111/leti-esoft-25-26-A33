@startuml
skinparam classAttributeIconSize 0

package "UI" {
  class SpecifyVaccineTypeUI {
  }
}

package "Core" {

  package "Controller" {
    class SpecifyVaccineTypeController {
      + createVaccineType(dto: VaccineTypeDTO): boolean
    }
  }

  package "Service" {
    class VaccineTypeService {
      + createVaccineType(dto: VaccineTypeDTO): boolean
    }
  }

  package "Domain" {
    package "Model" {
      class VaccineType {
        - code: String
        - description: String
        - technology: String
        + create(code, desc, tech)
      }
    }

    package "Repository" {
      class VaccineTypeRepository {
        + save(vt: VaccineType): boolean
        + findByCode(code: String): VaccineType
      }
    }
  }

  package "DTO" {
    class VaccineTypeDTO {
      - code
      - description
      - technology
    }
  }

  package "Mapper" {
    class VaccineTypeMapper {
      + toModel(dto: VaccineTypeDTO): VaccineType
      + toDTO(vt: VaccineType): VaccineTypeDTO
    }
  }
}

SpecifyVaccineTypeUI ..> SpecifyVaccineTypeController
SpecifyVaccineTypeUI ..> VaccineTypeDTO

SpecifyVaccineTypeController ..> VaccineTypeService
SpecifyVaccineTypeController ..> VaccineTypeDTO

VaccineTypeService ..> VaccineTypeRepository
VaccineTypeService ..> VaccineTypeMapper
VaccineTypeService ..> VaccineType
VaccineTypeService ..> VaccineTypeDTO

VaccineTypeMapper ..> VaccineTypeDTO
VaccineTypeMapper ..> VaccineType

VaccineTypeRepository "1" --> "*" VaccineType : stores

@enduml