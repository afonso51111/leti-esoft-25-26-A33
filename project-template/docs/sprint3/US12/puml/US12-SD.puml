@startuml
autonumber
actor "DGS Administrator" as Admin
participant ":ListVaccinesUI" as UI
participant ":ListVaccines\nController" as CTRL
participant ":Company" as CMP
participant "store\n:VaccineStore" as STORE

activate Admin
Admin -> UI : asks to list all vaccines
activate UI

UI -> CTRL : getVaccinesList()
activate CTRL

CTRL -> CMP : store = getVaccineStore()
activate CMP
deactivate CMP

CTRL -> STORE : getVaccines()
activate STORE
    note right of STORE
       1. Gets all vaccines
       2. Groups by Type
       3. Sorts by Brand (AC12-1)
    end note
deactivate STORE
STORE --> CTRL : vaccineList

CTRL --> UI : vaccineList
deactivate CTRL

UI --> Admin : displays the list of vaccines
deactivate UI
deactivate Admin

@enduml