@startuml
autonumber
actor "DGS Administrator" as Admin
participant ":ListVaccinesUI" as UI
participant ":ListVaccinesController" as CTRL
participant ":Company" as CMP
participant "store\n:VaccineStore" as STORE
participant "v\n:Vaccine" as VAX

activate Admin
Admin -> UI : asks to list all vaccines
activate UI

UI -> CTRL : getVaccineList()
activate CTRL

CTRL -> CMP : store = getVaccineStore()
activate CMP
deactivate CMP

CTRL -> STORE : allVaccines = getAll()
activate STORE
deactivate STORE

CTRL -> CTRL : sortAndGroup(allVaccines)

CTRL --> UI : sortedList
deactivate CTRL

UI --> Admin : shows the list of vaccines (grouped by type, sorted by brand)
deactivate UI
deactivate Admin
@enduml