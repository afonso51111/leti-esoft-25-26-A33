@startuml US15_SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "DGS Administrator" as Admin
participant ":ListEmployeeByRoleView" as View
participant ":ListEmployeeByRoleController" as Controller
participant ":Company" as Company
participant "store:EmployeeStore" as Store

activate Admin

    Admin -> View : asks to list employees by role
    activate View

        View -> Controller : getRoles()
        activate Controller
            note right of Controller: Roles are defined by\nEmployee subclasses\n(Nurse, Receptionist)
            Controller --> View : list of roles
        deactivate Controller

        View --> Admin : shows list of available roles
    deactivate View

    Admin -> View : selects a role
    activate View

        View -> View : keeps selected role

        View --> Admin : requests confirmation
    deactivate View

    Admin -> View : confirms
    activate View

        View -> Controller : getEmployeesByRole(role)
        activate Controller

            Controller -> Company : getEmployeeStore()
            activate Company
                Company --> Controller : store
            deactivate Company

            Controller -> Store : getEmployeesByRole(role)
            activate Store

                Store -> Store : filterByClassType(role)
                activate Store
                deactivate Store

                Store -> Store : sortByName(filteredList)
                activate Store
                deactivate Store

                Store --> Controller : sortedEmployeeList
            deactivate Store

            Controller --> View : sortedEmployeeList
        deactivate Controller

        View --> Admin : shows list of employees with selected role
    deactivate View

deactivate Admin

@enduml